---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Latent Form Theory">

  <article>
    <p class="eyebrow">The Foundation</p>

    <h1>
      Latent Form Theory
    </h1>

    <p class="lead">
      A framework for revealing inherent order through disciplined choice.
    </p>

    <section>
      <h2>The Premise</h2>

      <p>
        Every act of creation is an act of decision. The maker's role is not
        merely to add form, but to recognize the possibilities already present
        and determine what should remain.
      </p>
    </section>

  </article>

</BaseLayout>