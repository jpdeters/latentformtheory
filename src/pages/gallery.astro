---
// src/pages/gallery.astro
import BaseLayout from "../layouts/BaseLayout.astro";

const galleryItems = [
  {
    title: "Still Horizon Side Table",
    material: "Quarter-sawn White Oak",
    image: "/images/still-horizon.jpeg",
  },
  {
    title: "The Horizon Votive Holder",
    material: "Peruvian Walnut & White Oak",
    image: "/images/Horizon-Triplet-1.jpg",
  },
  {
    title: "Minimalist Media Console",
    material: "Peruvian Walnut",
    image: "/images/Constellation.png",
  },
  {
    title: "Geometric Table Lamp",
    material: "Quarter Sawn White Oak",
    image: "/images/Zenith.png",
  },
];
---

<BaseLayout title="Gallery — Latent Form Theory">
  <main class="gallery-wrapper">
    <header class="hero-section">
      <p class="eyebrow">Stabilized Evidence</p>
      <h1>Gallery</h1>
      <p class="lead">Forms in equilibrium with their constraints—resolved through the controlled reduction of material and the withdrawal of intervention.</p>
    </header>

    <section class="gallery-grid">
      {galleryItems.map((item) => (
        <div class="gallery-card">
          <div class="image-container">
            <img
  src={item.image}
  alt={item.title}
  class="gallery-image"
/>
          </div>
          
          <div class="item-meta">
            <h2>{item.title}</h2>
            <p>{item.material}</p>
          </div>
        </div>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  .gallery-wrapper {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 24px 120px;
  }

  .hero-section {
    padding: 120px 0 60px;
  }

  /* 2-Column Minimalist Grid */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 60px 40px;
  }

  .gallery-card {
    display: flex;
    flex-direction: column;
  }

  /* Restrained, non-bordered bounding container */
  .image-container {
    width: 100%;
    position: relative;
    background: transparent;
    overflow: hidden;
  }

  /* Clean, aspect-ratio locked placeholder */
  .placeholder-svg {
    width: 100%;
    height: auto;
    display: block;
    color: var(--text);
  }

  .gallery-image {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
  }

  /* Captions shifted below the frame with delicate font sizing */
  .item-meta {
    margin-top: 20px;
  }

  .item-meta h2 {
    font-size: 1.25rem;
    margin: 0 0 6px 0;
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  .item-meta p {
    font-size: 0.9rem;
    color: var(--muted);
    font-family: system-ui, -apple-system, sans-serif;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Single-column adjustment for balanced viewing on phone screens */
  @media (max-width: 750px) {
    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    
    .hero-section {
      padding: 60px 0 40px;
    }
  }
</style>