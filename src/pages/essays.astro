---
// src/pages/essays.astro
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const essays = (await getCollection("essays")).sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);
---

<BaseLayout title="Essays — Latent Form Theory">
  <main>
    <h1>Essays</h1>

    <section class="essay-grid">
      {essays.map((essay) => (
        <article class="essay-card">

          <a href={`/essays/${essay.id}/`} class="essay-link">

            <img
              src={`/images/essays/${essay.id}/hero.jpg`}
              alt={essay.data.title}
              class="essay-image"
            />

            <div class="essay-content">
              <h2>{essay.data.title}</h2>

              <p>{essay.data.description}</p>

              <span class="read-more">Read Essay →</span>
            </div>

          </a>

        </article>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  .essay-grid {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
  }

  .essay-card {
    border: 1px solid #ddd;
    padding: 1.5rem;
    transition: transform 0.2s ease;
  }

  .essay-card:hover {
    transform: translateY(-4px);
  }

  .essay-link {
    display: flex;
    width: 100%;
    gap: 2rem;
    color: inherit;
    text-decoration: none;
  }

  .essay-image {
    width: 240px;
    height: 160px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .essay-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .essay-content h2 {
    margin-top: 0;
    margin-bottom: 0.75rem;
  }

  .essay-content p {
    margin-bottom: 0;
    line-height: 1.6;
  }

  .read-more {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 600;
  }

  @media (max-width: 700px) {
    .essay-link {
      flex-direction: column;
    }

    .essay-image {
      width: 100%;
      height: auto;
    }
  }
</style>