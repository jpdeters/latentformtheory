---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const { title = "Latent Form Theory" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style>
  body {
    margin: 0;
    background: #faf9f6;
    color: #161616;
    font-family: Georgia, serif;
  }

  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }
</style>