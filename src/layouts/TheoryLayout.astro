---
import Layout from "./BaseLayout.astro";

const { frontmatter, headings = [] } = Astro.props;

const contents = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3
);
---

<Layout title={frontmatter.title}>
  <div class="theory-shell">
    <aside class="theory-sidebar">
      <details open>
        <summary>Contents</summary>

        <nav aria-label="Volume contents">
          {
            contents.map((heading) => (
              <a
                class:list={[
                  "contents-link",
                  { subsection: heading.depth === 3 },
                ]}
                href={`#${heading.slug}`}
              >
                {heading.text}
              </a>
            ))
          }
        </nav>
      </details>
    </aside>

    <article class="theory-text">
      <slot />
    </article>
  </div>
</Layout>

<style>
  .theory-shell {
    display: grid;
    grid-template-columns: 220px minmax(0, 760px);
    gap: 3rem;
    max-width: 1100px;
    margin: 0 auto;
    padding: 5rem 2rem;
    align-items: start;
  }

  .theory-sidebar {
    position: sticky;
    top: 3rem;
    font-size: 0.9rem;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
  }

  .theory-sidebar summary {
    margin-bottom: 1.25rem;
    font-weight: 600;
    cursor: pointer;
  }

  .contents-link {
    display: block;
    padding: 0.4rem 0;
    color: inherit;
    line-height: 1.35;
    text-decoration: none;
  }

  .contents-link:hover {
    text-decoration: underline;
  }

  .contents-link.subsection {
    padding-left: 0.75rem;
    font-size: 0.9rem;
    opacity: 0.72;
  }

  .theory-text {
    min-width: 0;
    font-size: 1.12rem;
    line-height: 1.75;
  }

  .theory-text :global(h2),
  .theory-text :global(h3) {
    scroll-margin-top: 3rem;
  }

  .theory-text :global(h2) {
    margin-top: 4rem;
    font-size: 2rem;
  }

  .theory-text :global(h3) {
    margin-top: 2.5rem;
    font-size: 1.35rem;
  }

  @media (max-width: 800px) {
    .theory-shell {
      display: block;
      padding: 2rem 1.25rem;
    }

    .theory-sidebar {
      position: static;
      max-height: none;
      margin-bottom: 3rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid #d8d4cd;
    }
  }
</style>